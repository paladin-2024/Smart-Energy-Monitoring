    <!-- ══════════════════════════════════════════════════════════ -->
    <mxCell id="flow-summary" value="DATA FLOW SEQUENCE&#xa;① ESP32 reads ADC → P = V × I every 500ms&#xa;② HTTP GET → ThingSpeak (field1–4) every 15s&#xa;③ MATLAB smooths data, React sends email alert&#xa;④ ESP32 publishes MQTT JSON → IoT Core every 15s&#xa;⑤ IoT Rule fires Lambda synchronously&#xa;⑥ Lambda: PutItem + Query last 10 readings&#xa;⑦ Lambda: HTTP GET → Open-Meteo temperature&#xa;⑧ Lambda: np.polyfit regression → predict next W&#xa;⑨ Lambda: publish prediction → energy/predictions&#xa;⑩ IoT Core delivers to ESP32 → OLED shows AI: xxxW&#xa;⑪ Grafana HTTP GET Lambda URL → live dashboard"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfefe;strokeColor=#1a252f;
             fontSize=12;fontStyle=1;fontColor=#000000;verticalAlign=top;align=left;
             strokeWidth=3;spacingLeft=12;"
      vertex="1" parent="1">
