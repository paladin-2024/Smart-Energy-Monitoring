{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDeviceConnect",
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:YOUR_REGION:YOUR_ACCOUNT_ID:client/esp32-001"
    },
    {
      "Sid": "AllowPublishSensorData",
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:YOUR_REGION:YOUR_ACCOUNT_ID:topic/energy/monitor"
    },
    {
      "Sid": "AllowSubscribePredictions",
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": "arn:aws:iot:YOUR_REGION:YOUR_ACCOUNT_ID:topicfilter/energy/predictions"
    },
    {
      "Sid": "AllowReceivePredictions",
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": "arn:aws:iot:YOUR_REGION:YOUR_ACCOUNT_ID:topic/energy/predictions"
    }
  ]
}
